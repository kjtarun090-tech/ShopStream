# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ShopStream Security & Admin Configuration
ADMIN_PASSCODE=
JWT_SECRET=

# Production Stack (Aiven Cloud / Docker Compose)
DATABASE_URL=postgresql+asyncpg://avnadmin:password@your-aiven-pg.aivencloud.com:12345/shopstream?ssl=require
KAFKA_BOOTSTRAP_SERVERS=your-aiven-kafka.aivencloud.com:12345
KAFKA_SECURITY_PROTOCOL=SSL
OPENSEARCH_URL=https://avnadmin:password@your-aiven-opensearch.aivencloud.com:12345
NEXT_PUBLIC_API_URL=http://localhost:8000
